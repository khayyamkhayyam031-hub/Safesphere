<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Location is used for SOS messages and the location screens. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- SOS alerts are delivered to guardians as SMS from the user's own SIM. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Audio evidence, recorded only while the Evidence screen is open. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SafeHer"
        tools:targetApi="31">

        <activity
            android:name=".auth.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SafeHer.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".auth.WelcomeActivity" android:exported="false" />
        <activity
            android:name=".auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".auth.ProfileSetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".home.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".guardians.AddGuardianActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".sos.SosCountdownActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.SafeHer.Emergency" />
        <activity
            android:name=".sos.EmergencyStatusActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity android:name=".location.LiveLocationActivity" android:exported="false" />
        <!-- Handle rotation in place so a ringing call or an active recording isn't torn down. -->
        <activity
            android:name=".fakecall.FakeCallActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />
        <activity android:name=".helplines.EmergencyHelplinesActivity" android:exported="false" />
        <activity
            android:name=".evidence.EvidenceActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false" />
        <activity android:name=".history.HistoryDetailsActivity" android:exported="false" />

        <receiver
            android:name=".sos.SmsStatusReceiver"
            android:exported="false" />

    </application>

</manifest>
