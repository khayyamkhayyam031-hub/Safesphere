<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".sos.EmergencyStatusActivity">

    <include layout="@layout/view_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/spacing_lg">

            <!-- Headline -->
            <LinearLayout
                android:id="@+id/headerCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_banner_emergency"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:id="@+id/tvHeadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:accessibilityLiveRegion="polite"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_heading" />

                <TextView
                    android:id="@+id/tvHeadlineDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_supporting" />
            </LinearLayout>

            <!-- Overview -->
            <TextView
                style="@style/Widget.SafeHer.SectionHeader"
                android:text="@string/emergency_section_overview" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingTop="6dp"
                    android:paddingEnd="@dimen/card_padding"
                    android:paddingBottom="6dp">

                    <include
                        android:id="@+id/rowEvent"
                        layout="@layout/item_detail_row" />

                    <include
                        android:id="@+id/rowStarted"
                        layout="@layout/item_detail_row" />

                    <include
                        android:id="@+id/rowTrigger"
                        layout="@layout/item_detail_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Location -->
            <TextView
                style="@style/Widget.SafeHer.SectionHeader"
                android:text="@string/emergency_section_location" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingTop="6dp"
                    android:paddingEnd="@dimen/card_padding"
                    android:paddingBottom="@dimen/card_padding">

                    <include
                        android:id="@+id/rowLocation"
                        layout="@layout/item_detail_row" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenMap"
                        style="@style/Widget.SafeHer.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/location_open_map"
                        android:visibility="gone"
                        app:icon="@drawable/ic_map" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Alerts -->
            <TextView
                style="@style/Widget.SafeHer.SectionHeader"
                android:text="@string/emergency_section_alerts" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingTop="6dp"
                    android:paddingEnd="@dimen/card_padding"
                    android:paddingBottom="@dimen/card_padding">

                    <include
                        android:id="@+id/rowAlertSummary"
                        layout="@layout/item_detail_row" />

                    <View
                        style="@style/Widget.SafeHer.Divider"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:id="@+id/attemptList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/tvAlertNote"
                        style="@style/Text.SafeHer.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAlertAction"
                        style="@style/Widget.SafeHer.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Evidence -->
            <TextView
                style="@style/Widget.SafeHer.SectionHeader"
                android:text="@string/emergency_section_evidence" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingTop="6dp"
                    android:paddingEnd="@dimen/card_padding"
                    android:paddingBottom="@dimen/card_padding">

                    <include
                        android:id="@+id/rowEvidence"
                        layout="@layout/item_detail_row" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRecord"
                        style="@style/Widget.SafeHer.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/emergency_record_audio"
                        app:icon="@drawable/ic_mic" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/bg_banner_info"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="@dimen/icon_size_small"
                    android:layout_height="@dimen/icon_size_small"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_info"
                    app:tint="@color/primary_dark" />

                <TextView
                    style="@style/Text.SafeHer.Supporting"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/emergency_local_note"
                    android:textColor="@color/primary_dark" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Actions -->
    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_md">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCallPolice"
            style="@style/Widget.SafeHer.Button.Danger"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/emergency_call_police"
            app:icon="@drawable/ic_phone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResolve"
            style="@style/Widget.SafeHer.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/sos_resolve" />
    </LinearLayout>

</LinearLayout>
