<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Setup -->
    <LinearLayout
        android:id="@+id/setupGroup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <include layout="@layout/view_toolbar" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding"
                android:paddingBottom="@dimen/spacing_lg">

                <TextView
                    style="@style/Text.SafeHer.Supporting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fake_call_intro" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCaller"
                    style="@style/Widget.SafeHer.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/fake_call_caller_name">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLength="40" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/Widget.SafeHer.SectionHeader"
                    android:text="@string/fake_call_delay" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/delayChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:background="@drawable/bg_banner_info"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="@dimen/icon_size_small"
                        android:layout_height="@dimen/icon_size_small"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_info"
                        app:tint="@color/primary_dark" />

                    <TextView
                        style="@style/Text.SafeHer.Supporting"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/fake_call_simulation_note"
                        android:textColor="@color/primary_dark" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvScheduled"
                    style="@style/Text.SafeHer.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSchedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fake_call_schedule"
                app:icon="@drawable/ic_timer" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelSchedule"
                style="@style/Widget.SafeHer.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fake_call_cancel_schedule"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Incoming / in-call screen -->
    <LinearLayout
        android:id="@+id/callGroup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/call_background"
        android:fitsSystemWindows="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvCallState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/call_text_secondary"
            android:textSize="@dimen/text_size_body" />

        <TextView
            android:id="@+id/tvCallerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="34sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="@string/fake_call_mobile"
            android:textColor="@color/call_text_secondary"
            android:textSize="@dimen/text_size_supporting" />

        <FrameLayout
            android:id="@+id/callAvatar"
            android:layout_width="@dimen/avatar_size_call"
            android:layout_height="@dimen/avatar_size_call"
            android:layout_marginTop="@dimen/spacing_xl"
            android:background="@drawable/bg_call_avatar">

            <TextView
                android:id="@+id/tvCallerInitial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:textColor="@color/white"
                android:textSize="48sp" />
        </FrameLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/ringingActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_xl"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnDecline"
                    android:layout_width="@dimen/call_action_size"
                    android:layout_height="@dimen/call_action_size"
                    android:background="@drawable/bg_call_decline"
                    android:contentDescription="@string/fake_call_decline"
                    android:padding="20dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_call_end"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:importantForAccessibility="no"
                    android:text="@string/fake_call_decline"
                    android:textColor="@color/white" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnAccept"
                    android:layout_width="@dimen/call_action_size"
                    android:layout_height="@dimen/call_action_size"
                    android:background="@drawable/bg_call_accept"
                    android:contentDescription="@string/fake_call_accept"
                    android:padding="20dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_phone"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:importantForAccessibility="no"
                    android:text="@string/fake_call_accept"
                    android:textColor="@color/white" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnEndCall"
            android:layout_width="@dimen/call_action_size"
            android:layout_height="@dimen/call_action_size"
            android:layout_marginBottom="@dimen/spacing_xl"
            android:background="@drawable/bg_call_decline"
            android:contentDescription="@string/fake_call_end"
            android:padding="20dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_call_end"
            android:visibility="gone"
            app:tint="@color/white" />
    </LinearLayout>
</FrameLayout>
