<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Base.Theme.SafeHer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_deep_purple</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_light</item>
        <item name="colorOnPrimaryContainer">@color/primary_dark</item>
        <item name="colorSecondary">@color/primary_deep_purple</item>
        <item name="colorOnSecondary">@color/on_primary</item>
        <item name="colorSecondaryContainer">@color/primary_light</item>
        <item name="colorOnSecondaryContainer">@color/primary_dark</item>
        <item name="colorError">@color/emergency_red</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/main_text</item>
        <item name="colorOnSurfaceVariant">@color/secondary_text</item>
        <item name="colorSurfaceContainerLowest">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorSurfaceContainerHighest">@color/neutral_chip_bg</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/divider</item>
        <item name="android:textColorPrimary">@color/main_text</item>
        <item name="android:textColorSecondary">@color/secondary_text</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
        <item name="materialButtonStyle">@style/Widget.SafeHer.Button</item>
        <item name="materialCardViewStyle">@style/Widget.SafeHer.Card</item>
    </style>

    <style name="Theme.SafeHer" parent="Base.Theme.SafeHer" />

    <style name="Theme.SafeHer.Splash">
        <item name="android:windowBackground">@drawable/splash_screen</item>
    </style>

    <!-- Countdown screen: full emergency red. -->
    <style name="Theme.SafeHer.Emergency">
        <item name="android:windowBackground">@color/emergency_red</item>
        <item name="android:statusBarColor">@color/emergency_red</item>
        <item name="android:navigationBarColor">@color/emergency_red</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.SafeHer.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.SafeHer.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.SafeHer.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="strokeColor">@color/outline</item>
        <item name="android:textColor">@color/accent_text</item>
        <item name="iconTint">@color/accent_text</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.SafeHer.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:textSize">@dimen/text_size_supporting</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/accent_text</item>
    </style>

    <style name="Widget.SafeHer.Button.Danger" parent="Widget.SafeHer.Button">
        <item name="backgroundTint">@color/emergency_red</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
    </style>

    <!-- Inputs -->
    <style name="Widget.SafeHer.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/input_corner_radius</item>
        <item name="boxStrokeColor">@color/primary_deep_purple</item>
        <item name="boxStrokeErrorColor">@color/emergency_red</item>
        <item name="errorTextColor">@color/emergency_red_text</item>
        <item name="android:layout_marginTop">@dimen/spacing_md</item>
    </style>

    <style name="Widget.SafeHer.TextInputLayout.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/input_corner_radius</item>
        <item name="boxStrokeColor">@color/primary_deep_purple</item>
        <item name="android:layout_marginTop">@dimen/spacing_md</item>
    </style>

    <!-- Cards -->
    <style name="Widget.SafeHer.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Typography -->
    <style name="Text.SafeHer" parent="">
        <item name="android:textColor">@color/main_text</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Text.SafeHer.Display">
        <item name="android:textSize">@dimen/text_size_display</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.SafeHer.Heading">
        <item name="android:textSize">@dimen/text_size_heading</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.SafeHer.Section">
        <item name="android:textSize">@dimen/text_size_section</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.SafeHer.Body">
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Text.SafeHer.Supporting">
        <item name="android:textSize">@dimen/text_size_supporting</item>
        <item name="android:textColor">@color/secondary_text</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Text.SafeHer.Caption">
        <item name="android:textSize">@dimen/text_size_small</item>
        <item name="android:textColor">@color/secondary_text</item>
    </style>

    <style name="Text.SafeHer.Label">
        <item name="android:textSize">@dimen/text_size_small</item>
        <item name="android:textColor">@color/secondary_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="Text.SafeHer.Error">
        <item name="android:textSize">@dimen/text_size_supporting</item>
        <item name="android:textColor">@color/emergency_red_text</item>
    </style>

    <!-- Status chip: text always states the status, colour only reinforces it. -->
    <style name="Widget.SafeHer.StatusChip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_status_chip</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textSize">@dimen/text_size_small</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- 48dp icon button -->
    <style name="Widget.SafeHer.IconButton" parent="">
        <item name="android:layout_width">@dimen/touch_target_min</item>
        <item name="android:layout_height">@dimen/touch_target_min</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/secondary_text</item>
    </style>

    <!-- Settings rows -->
    <style name="Widget.SafeHer.SettingsRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">@dimen/card_padding</item>
        <item name="android:paddingEnd">@dimen/card_padding</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.SafeHer.SectionHeader" parent="Text.SafeHer.Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/spacing_lg</item>
        <item name="android:layout_marginBottom">@dimen/spacing_sm</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:accessibilityHeading">true</item>
    </style>

    <style name="ShapeAppearance.SafeHer.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.SafeHer.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primary_light</item>
    </style>

    <style name="Widget.SafeHer.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/divider</item>
    </style>
</resources>
